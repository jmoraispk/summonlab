{
	"name": "summonlab",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=24.14.1 <25",
		"pnpm": ">=10.33.0 <11"
	},
	"scripts": {
		"dev": "node tools/dev.mjs --with-db",
		"dev:app": "node tools/dev.mjs",
		"smoke:dev": "node tools/dev.mjs --with-db --smoke",
		"db:start": "node tools/database.mjs start",
		"db:stop": "node tools/database.mjs stop",
		"db:logs": "node tools/database.mjs logs",
		"db:migrate": "pnpm --filter @summonlab/database migrate",
		"simulate:engine": "pnpm --filter @summonlab/engine simulate",
		"validate:visual-assets": "tsx tools/validate-visual-assets.ts",
		"export:runtime-visuals": "tsx tools/export-runtime-visuals.ts",
		"validate:runtime-visuals": "tsx tools/export-runtime-visuals.ts --check",
		"export:recognition-audit": "tsx tools/export-recognition-audit.ts",
		"validate:recognition-audit": "tsx tools/export-recognition-audit.ts --check",
		"export:agent-evaluation": "tsx tools/export-agent-evaluation.ts",
		"validate:agent-evaluation": "tsx tools/export-agent-evaluation.ts --check",
		"export:foundry-strategies": "tsx tools/export-foundry-strategies.ts",
		"validate:foundry-strategies": "tsx tools/export-foundry-strategies.ts --check",
		"export:attempt-aftermath": "tsx tools/export-attempt-aftermath.ts",
		"validate:attempt-aftermath": "tsx tools/export-attempt-aftermath.ts --check",
		"export:master-timing": "tsx tools/export-master-timing.ts",
		"validate:master-timing": "tsx tools/export-master-timing.ts --check",
		"export:master-fallback": "tsx tools/export-master-fallback.ts",
		"validate:master-fallback": "tsx tools/export-master-fallback.ts --check",
		"export:player-journal": "tsx tools/export-player-journal.ts",
		"validate:player-journal": "tsx tools/export-player-journal.ts --check",
		"export:story-envelope": "tsx tools/export-story-envelope.ts",
		"validate:story-envelope": "tsx tools/export-story-envelope.ts --check",
		"export:story-patch": "tsx tools/export-story-patch.ts",
		"validate:story-patch": "tsx tools/export-story-patch.ts --check",
		"export:synthesis": "tsx tools/export-synthesis.ts",
		"validate:synthesis": "tsx tools/export-synthesis.ts --check",
		"record:agent-evaluation": "tsx tools/record-agent-evaluation.ts --acknowledge-paid-provider-run",
		"validate:settlement-content": "tsx tools/validate-settlement-content.ts",
		"validate:settlement-scene": "tsx tools/validate-settlement-scene.ts",
		"validate:mission-content": "tsx tools/validate-mission-content.ts",
		"measure:web-build-budget": "pnpm --filter @summonlab/web build && node tools/validate-web-build-budget.mjs --write",
		"validate:web-build-budget": "node tools/validate-web-build-budget.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "pnpm -r --if-present lint",
		"typecheck": "pnpm -r --if-present typecheck",
		"test": "pnpm -r --if-present test",
		"test:integration": "pnpm -r --if-present test:integration",
		"build": "pnpm -r --if-present build",
		"check": "pnpm format:check && pnpm validate:visual-assets && pnpm validate:runtime-visuals && pnpm validate:recognition-audit && pnpm validate:agent-evaluation && pnpm validate:foundry-strategies && pnpm validate:attempt-aftermath && pnpm validate:master-timing && pnpm validate:master-fallback && pnpm validate:player-journal && pnpm validate:story-envelope && pnpm validate:story-patch && pnpm validate:synthesis && pnpm validate:settlement-content && pnpm validate:settlement-scene && pnpm validate:mission-content && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm validate:web-build-budget",
		"test:e2e": "pnpm --filter @summonlab/web test:e2e"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.10.0",
		"concurrently": "^10.0.5",
		"eslint": "^10.4.1",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sharp": "0.35.3",
		"tsup": "^8.5.1",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.8"
	}
}
