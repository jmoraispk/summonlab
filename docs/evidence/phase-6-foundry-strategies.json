			"displayName": "Hammer Line",
			"thesis": "Preparation can make the obvious route genuinely viable, even while the furnace stays lit.",
			"preparation": "Train a four-hero line to sword rank 10, cycle both gate weapons, and enter without Floor 04 route knowledge.",
			"tradeoff": "The Warden keeps all three armor layers, so the company must clear the nave and rotate its exposed front line.",
			"requiresRouteMemory": false,
			"targetFurnaceState": "lit"
		},
		{
			"strategyId": "split-cooling",
			"displayName": "Split Cooling",
			"thesis": "One remembered secret can shorten the fight without paying the full cost of a quench.",
			"preparation": "Let the schematic holder expose the seam, test the wheel, and advance the furnace once while the Master holds the heart.",
			"tradeoff": "The operator draws the Warden into the control room and the company fights through one remaining armor layer.",
			"requiresRouteMemory": true,
			"targetFurnaceState": "cooling"
		},
		{
			"strategyId": "full-quench",
			"displayName": "Full Quench",
			"thesis": "Trust the isolated operator for one additional turn to remove every furnace-linked armor layer.",
			"preparation": "Carry the Floor 04 schematic memory, reveal the maintenance path, test the wheel, then operate it twice.",
			"tradeoff": "The exposed holder endures another intercept before the shortest and hardest-hitting finish.",
			"requiresRouteMemory": true,
			"targetFurnaceState": "quenched"
		}
	],
