{
  "schemaVersion": "enemy-normal-blind-reconciliation-v2",
  "evidenceScope": "50 active revised canonical Normal T3/T5 anchors",
  "policy": {
    "identity": "Pass only when the label-hidden perceived family or creature semantically identifies the mapped family and form; ambiguous neighboring-family or wrong-family reads fail.",
    "tier": {
      "rationale": "The v2 blind prompt did not constrain perceivedTier to numeric T3/T5 vocabulary, so conservative semantic normalization is used instead of rejecting every review for a format mismatch.",
      "T3AcceptedPerceptions": [
        "common",
        "normal",
        "standard",
        "mid",
        "elite"
      ],
      "T5AcceptedPerceptions": [
        "elite",
        "high",
        "boss"
      ],
      "overlapNote": "elite intentionally overlaps because it denotes upper-mid or boss presentation without numeric calibration",
      "failureRule": "T3 perceived as boss or high fails; T5 perceived as normal, common, standard, or mid fails; any term outside the target set fails."
    },
    "archetype": "Pass only when the label-hidden perceived combat role semantically communicates the mapped form's primary archetype or battlefield duty.",
    "sourceDimensions": "Anatomy, neutral affinity, visible counterplay cue, framing, and finish are preserved exactly from each reviewer-authored verdict and translated from pass/revise to pass/fail receipt rubric values.",
    "decision": "approved-review requires all eight receipt dimensions to pass. A reviewer-authored revise is never upgraded; an otherwise-approved review is downgraded when identity, tier, or archetype reconciliation fails."
  },
