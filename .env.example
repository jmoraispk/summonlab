# Server runtime
NODE_ENV=development
HOST=0.0.0.0
WEB_PORT=5173
WORKER_PORT=4174
SIMULATION_SPEED=4
CATCH_UP_POLL_MS=1000
LOG_LEVEL=info

# Local PostgreSQL started by `pnpm dev`
DATABASE_URL=postgresql://summonlab:summonlab@127.0.0.1:54329/summonlab

# Policy calls stay disabled until Phase 5. Phase 0 defaults to scripted.
POLICY_MODE=scripted
OPENAI_POLICY_MODEL=gpt-5-nano
# OPENAI_API_KEY=

# Development-only, one-candidate summon-card experiment. Disabled by default.
ENABLE_IMAGE_GENERATION=false
OPENAI_IMAGE_MODEL=gpt-image-2-2026-04-21
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_TIMEOUT_MS=120000

# Local-only deterministic replay inspector. Defaults off in production.
ENABLE_DEV_ROUTES=true

# Normally injected by CI or tools/dev.mjs
# SUMMONLAB_COMMIT_SHA=
