# Server runtime
NODE_ENV=development
HOST=0.0.0.0
WEB_PORT=5173
WORKER_PORT=4174
SIMULATION_SPEED=4
CATCH_UP_POLL_MS=1000
DECISION_JOB_POLL_MS=500
DECISION_JOB_LEASE_SECONDS=45
DECISION_JOB_MAX_PROVIDER_ATTEMPTS=2
DECISION_JOB_MAX_REPLANS=3
LOG_LEVEL=info

# Local PostgreSQL started by `pnpm dev`
DATABASE_URL=postgresql://summonlab:summonlab@127.0.0.1:54329/summonlab

# Scripted jobs are free by default. Set POLICY_MODE=model and provide a key to enable
# an explicitly acknowledged queued model decision; every model job may retry once.
POLICY_MODE=scripted
OPENAI_POLICY_MODEL=gpt-5-nano
OPENAI_POLICY_TIMEOUT_MS=30000
OPENAI_POLICY_MAX_OUTPUT_TOKENS=800
OPENAI_POLICY_REASONING_EFFORT=minimal
# OPENAI_API_KEY=

# Development-only, one-candidate summon-card experiment. Disabled by default.
ENABLE_IMAGE_GENERATION=false
OPENAI_IMAGE_MODEL=gpt-image-2-2026-04-21
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_TIMEOUT_MS=120000

# Local-only deterministic replay inspector. Defaults off in production.
ENABLE_DEV_ROUTES=true

# Optional server-owned local operator for evidence-authoritative affinity review.
# Leave unset until the trusted Forge/API integration is enabled.
# AFFINITY_REVIEW_ACTOR=visual-director

# Normally injected by CI or tools/dev.mjs
# SUMMONLAB_COMMIT_SHA=
