{
	"name": "@summonlab/worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
		"lint": "eslint src",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --exclude '**/*.integration.spec.ts'",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	},
	"dependencies": {
		"@summonlab/config": "workspace:*",
		"@summonlab/contracts": "workspace:*",
		"@summonlab/database": "workspace:*",
		"@summonlab/engine": "workspace:*",
		"@summonlab/observability": "workspace:*",
		"@summonlab/policies": "workspace:*",
		"@summonlab/queue": "workspace:*"
	},
	"devDependencies": {
		"@summonlab/characters": "workspace:*",
		"@summonlab/content": "workspace:*"
	}
}
