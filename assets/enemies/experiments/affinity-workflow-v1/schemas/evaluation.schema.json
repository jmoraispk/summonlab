{
	"$id": "https://summonlab.local/schemas/image-production-evaluation-v1.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": { "type": "string", "const": "image-production-evaluation-v1" },
		"experimentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
		"generatedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"catalogHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
		"status": { "type": "string", "enum": ["incomplete", "passed", "failed"] },
		"controlled": {
			"type": "object",
			"properties": {
				"targetCount": { "type": "number", "const": 24 },
				"firstAttemptCandidateCount": { "type": "integer", "minimum": 0, "maximum": 24 },
				"speciesCorrectCount": { "type": "integer", "minimum": 0, "maximum": 24 },
				"affinityCorrectCount": { "type": "integer", "minimum": 0, "maximum": 24 },
				"normalUnaffiliatedCount": { "type": "integer", "minimum": 0, "maximum": 4 },
				"acceptedMeaningfulAffinityCount": { "type": "integer", "minimum": 0, "maximum": 20 },
				"acceptedCriticalVisualFailureCount": { "type": "integer", "minimum": 0, "maximum": 24 }
			},
			"required": [
				"targetCount",
				"firstAttemptCandidateCount",
				"speciesCorrectCount",
				"affinityCorrectCount",
				"normalUnaffiliatedCount",
				"acceptedMeaningfulAffinityCount",
				"acceptedCriticalVisualFailureCount"
			],
			"additionalProperties": false
		},
		"workflow": {
			"type": "object",
			"properties": {
				"completedTargetCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"completeProvenanceCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"pathConflictCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"sharedFileEditCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
				"retryCeilingViolationCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"completedTargetCount",
				"completeProvenanceCount",
				"pathConflictCount",
				"sharedFileEditCount",
				"retryCeilingViolationCount"
			],
			"additionalProperties": false
		},
		"blindReviews": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"reviewId": {
						"type": "string",
						"format": "uuid",
						"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
					},
					"targetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
					"candidateContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
					"reviewer": { "type": "string", "minLength": 1, "maxLength": 100 },
					"reviewMode": { "type": "string", "const": "blind" },
					"reviewedAt": {
						"type": "string",
						"format": "date-time",
						"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
					},
					"identifiedSpeciesId": {
						"type": "string",
						"enum": [
							"death-knight",
							"elemental",
							"gray-wolf",
							"cave-bear",
							"goblin",
							"tunnel-boar",
							"cave-drake",
							"tower-basilisk"
						]
					},
					"identifiedAffinity": {
						"type": "string",
						"enum": ["normal", "wood", "fire", "metal", "water", "wind"]
					},
					"speciesCorrect": { "type": "boolean" },
					"affinityCorrect": { "type": "boolean" },
					"scores": {
						"type": "object",
						"properties": {
							"speciesIdentity": { "type": "integer", "minimum": 1, "maximum": 5 },
							"affinityReadability": { "type": "integer", "minimum": 1, "maximum": 5 },
							"silhouetteAndDuty": { "type": "integer", "minimum": 1, "maximum": 5 },
							"materialCredibility": { "type": "integer", "minimum": 1, "maximum": 5 },
							"anatomyAndGroundContact": { "type": "integer", "minimum": 1, "maximum": 5 },
							"affinityIntegration": { "type": "integer", "minimum": 1, "maximum": 5 },
							"styleCohesion": { "type": "integer", "minimum": 1, "maximum": 5 }
						},
						"required": [
							"speciesIdentity",
							"affinityReadability",
							"silhouetteAndDuty",
							"materialCredibility",
							"anatomyAndGroundContact",
							"affinityIntegration",
							"styleCohesion"
						],
						"additionalProperties": false
					},
					"verdict": { "type": "string", "enum": ["candidate", "revise"] },
					"note": { "type": "string", "minLength": 1, "maxLength": 1000 }
				},
				"required": [
					"reviewId",
					"targetId",
					"candidateContentHash",
					"reviewer",
					"reviewMode",
					"reviewedAt",
					"identifiedSpeciesId",
					"identifiedAffinity",
					"speciesCorrect",
					"affinityCorrect",
					"scores",
					"verdict",
					"note"
				],
				"additionalProperties": false
			}
		},
		"concurrencyStages": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"stage": {
						"type": "string",
						"enum": ["canary", "pilot", "controlled", "breadth", "load", "scale"]
					},
					"plannedParallelJobs": {
						"anyOf": [
							{ "type": "number", "const": 2 },
							{ "type": "number", "const": 4 },
							{ "type": "number", "const": 6 },
							{ "type": "number", "const": 8 },
							{ "type": "number", "const": 12 },
							{ "type": "number", "const": 16 }
						]
					},
					"effectiveParallelJobs": { "type": "integer", "exclusiveMinimum": 0, "maximum": 16 },
					"targetCount": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
					"candidateCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
					"reviseCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
					"failedCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
					"throttleCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
					"timeoutCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
					"retryCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
					"generationMedianMs": { "type": "number", "minimum": 0 },
					"generationP90Ms": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
					"generationP95Ms": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
					"slowestCompletionMs": { "type": "number", "minimum": 0 },
					"waveWallTimeMs": { "type": "number", "exclusiveMinimum": 0 },
					"summedJobTimeMs": { "type": "number", "exclusiveMinimum": 0 },
					"effectiveSpeedup": { "type": "number", "exclusiveMinimum": 0 },
					"parallelEfficiency": { "type": "number", "exclusiveMinimum": 0 },
					"queueDelayMs": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
					"visualCandidateRate": { "type": "number", "minimum": 0, "maximum": 1 },
					"provenanceCompletenessRate": { "type": "number", "minimum": 0, "maximum": 1 },
					"missingResultCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
					"duplicateIdCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
					"pathConflictCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
					"integrationErrorCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
				},
				"required": [
					"stage",
					"plannedParallelJobs",
					"effectiveParallelJobs",
					"targetCount",
					"candidateCount",
					"reviseCount",
					"failedCount",
					"throttleCount",
					"timeoutCount",
					"retryCount",
					"generationMedianMs",
					"generationP90Ms",
					"generationP95Ms",
					"slowestCompletionMs",
					"waveWallTimeMs",
					"summedJobTimeMs",
					"effectiveSpeedup",
					"parallelEfficiency",
					"queueDelayMs",
					"visualCandidateRate",
					"provenanceCompletenessRate",
					"missingResultCount",
					"duplicateIdCount",
					"pathConflictCount",
					"integrationErrorCount"
				],
				"additionalProperties": false
			}
		},
		"failureClassifications": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"failureId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
					"targetId": {
						"anyOf": [{ "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" }, { "type": "null" }]
					},
					"layer": {
						"type": "string",
						"enum": [
							"skill",
							"execution-contract",
							"species-grammar",
							"affinity-grammar",
							"target",
							"generator-variance",
							"manifest-generator",
							"orchestrator",
							"scheduler",
							"integration"
						]
					},
					"description": { "type": "string", "minLength": 1, "maxLength": 1000 },
					"resolution": {
						"anyOf": [{ "type": "string", "minLength": 1, "maxLength": 1000 }, { "type": "null" }]
					}
				},
				"required": ["failureId", "targetId", "layer", "description", "resolution"],
				"additionalProperties": false
			}
		},
		"recommendedSafeConcurrency": {
			"anyOf": [{ "type": "integer", "minimum": 1, "maximum": 16 }, { "type": "null" }]
		},
		"completionNotes": {
			"type": "array",
			"items": { "type": "string", "minLength": 1, "maxLength": 1000 }
		}
	},
	"required": [
		"schemaVersion",
		"experimentId",
		"generatedAt",
		"catalogHash",
		"status",
		"controlled",
		"workflow",
		"blindReviews",
		"concurrencyStages",
		"failureClassifications",
		"recommendedSafeConcurrency",
		"completionNotes"
	],
	"additionalProperties": false
}
