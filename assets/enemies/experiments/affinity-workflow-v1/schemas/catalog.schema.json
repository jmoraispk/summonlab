{
	"$id": "https://summonlab.local/schemas/image-production-catalog-v1.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": { "type": "string", "const": "image-production-catalog-v1" },
		"experimentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
		"generatedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"status": { "type": "string", "const": "experimental-unpromoted" },
		"entries": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"targetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
					"resultId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
					"assignmentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
					"speciesId": {
						"type": "string",
						"enum": [
							"death-knight",
							"elemental",
							"grey-wolf",
							"cave-bear",
							"goblin",
							"tunnel-boar",
							"cave-drake",
							"tower-basilisk"
						]
					},
					"affinity": {
						"type": "string",
						"enum": ["normal", "wood", "fire", "metal", "water", "wind"]
					},
					"cohort": { "type": "string", "enum": ["controlled", "breadth", "regression"] },
					"status": { "type": "string", "enum": ["candidate", "revise", "failed"] },
					"candidatePath": {
						"anyOf": [
							{ "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\.(?:png|webp)$" },
							{ "type": "null" }
						]
					},
					"candidateHash": {
						"anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }]
					},
					"reviewState": {
						"type": "string",
						"enum": ["pending", "accepted", "revise", "rejected"]
					},
					"promoted": { "type": "boolean", "const": false }
				},
				"required": [
					"targetId",
					"resultId",
					"assignmentId",
					"speciesId",
					"affinity",
					"cohort",
					"status",
					"candidatePath",
					"candidateHash",
					"reviewState",
					"promoted"
				],
				"additionalProperties": false
			}
		}
	},
	"required": ["schemaVersion", "experimentId", "generatedAt", "status", "entries"],
	"additionalProperties": false
}
