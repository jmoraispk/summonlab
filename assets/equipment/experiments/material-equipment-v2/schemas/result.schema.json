{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "string",
			"const": "equipment-image-result-v2"
		},
		"resultId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{1,159}$"
		},
		"targetId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{1,159}$"
		},
		"assignmentId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{1,159}$"
		},
		"status": {
			"type": "string",
			"enum": [
				"candidate",
				"revise",
				"failed"
			]
		},
		"humanReviewLabel": {
			"type": "string",
			"enum": [
				"Pass",
				"Check",
				"No image"
			]
		},
		"promptSha256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"referenceInputs": {
			"minItems": 1,
			"maxItems": 20,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"referenceId": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{1,159}$"
					},
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 500
					},
					"contentHash": {
						"type": "string",
						"pattern": "^[a-f0-9]{64}$"
					}
				},
				"required": [
					"referenceId",
					"path",
					"contentHash"
				],
				"additionalProperties": false
			}
		},
		"attempts": {
			"minItems": 1,
			"maxItems": 1,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"attemptId": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{1,159}$"
					},
					"attemptNumber": {
						"type": "number",
						"const": 1
					},
					"sourceOutputId": {
						"anyOf": [
							{
								"type": "string",
								"minLength": 1,
								"maxLength": 300
							},
							{
								"type": "null"
							}
						]
					},
					"requestStartedAt": {
						"type": "string",
						"format": "date-time",
						"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
					},
					"generationCompletedAt": {
						"type": "string",
						"format": "date-time",
						"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
					},
					"inspectionCompletedAt": {
						"type": "string",
						"format": "date-time",
						"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
					}
				},
				"required": [
					"attemptId",
					"attemptNumber",
					"sourceOutputId",
					"requestStartedAt",
					"generationCompletedAt",
					"inspectionCompletedAt"
				],
				"additionalProperties": false
			}
		},
		"findings": {
			"minItems": 1,
			"maxItems": 40,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"criterionId": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{1,159}$"
					},
					"outcome": {
						"type": "string",
						"enum": [
							"pass",
							"concern",
							"fail",
							"not-applicable"
						]
					},
					"observation": {
						"type": "string",
						"minLength": 1,
						"maxLength": 4000
					}
				},
				"required": [
					"criterionId",
					"outcome",
					"observation"
				],
				"additionalProperties": false
			}
		},
		"candidate": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"path": {
							"type": "string",
							"minLength": 1,
							"maxLength": 500
						},
						"mediaType": {
							"type": "string",
							"const": "image/png"
						},
						"width": {
							"type": "number",
							"const": 1024
						},
						"height": {
							"anyOf": [
								{
									"type": "number",
									"const": 1024
								},
								{
									"type": "number",
									"const": 1536
								}
							]
						},
						"bytes": {
							"type": "integer",
							"exclusiveMinimum": 0,
							"maximum": 9007199254740991
						},
						"sha256": {
							"type": "string",
							"pattern": "^[a-f0-9]{64}$"
						}
					},
					"required": [
						"path",
						"mediaType",
						"width",
						"height",
						"bytes",
						"sha256"
					],
					"additionalProperties": false
				},
				{
					"type": "null"
				}
			]
		},
		"candidateSha256": {
			"anyOf": [
				{
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				},
				{
					"type": "null"
				}
			]
		},
		"startedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"completedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"writtenOutputPaths": {
			"minItems": 1,
			"maxItems": 2,
			"type": "array",
			"items": {
				"anyOf": [
					{
						"type": "string",
						"minLength": 1,
						"maxLength": 500
					},
					{
						"type": "string",
						"minLength": 1,
						"maxLength": 500
					}
				]
			}
		},
		"noSharedFilesEdited": {
			"type": "boolean",
			"const": true
		},
		"selfPromoted": {
			"type": "boolean",
			"const": false
		}
	},
	"required": [
		"schemaVersion",
		"resultId",
		"targetId",
		"assignmentId",
		"status",
		"humanReviewLabel",
		"promptSha256",
		"referenceInputs",
		"attempts",
		"findings",
		"candidate",
		"candidateSha256",
		"startedAt",
		"completedAt",
		"writtenOutputPaths",
		"noSharedFilesEdited",
		"selfPromoted"
	],
	"additionalProperties": false,
	"$id": "https://summonlab.local/schemas/equipment/v2/result.schema.json",
	"$comment": "Structural interchange validation only. Equipment v2 acceptance and packet processing must also run the corresponding Zod semantic schema."
}
