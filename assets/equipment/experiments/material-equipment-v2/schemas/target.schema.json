{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "string",
			"const": "equipment-image-target-v2"
		},
		"targetId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{1,159}$"
		},
		"productionId": {
			"type": "string",
			"const": "material-equipment-v2"
		},
		"profileId": {
			"type": "string",
			"const": "equipment-material-visual-profile-v2"
		},
		"manifestCanonicalSha256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"allocationCanonicalSha256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"profileCanonicalSha256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"profileAcceptanceCanonicalSha256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"material": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]{1,159}$"
				},
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 120
				},
				"family": {
					"type": "string",
					"enum": [
						"metal",
						"wood",
						"hide-scale",
						"cloth-fibre"
					]
				},
				"rank": {
					"type": "string",
					"enum": [
						"F",
						"E",
						"D",
						"C",
						"B",
						"A",
						"S"
					]
				},
				"craftsmanship": {
					"type": "string",
					"const": "Standard"
				}
			},
			"required": [
				"id",
				"name",
				"family",
				"rank",
				"craftsmanship"
			],
			"additionalProperties": false
		},
		"equipment": {
			"type": "object",
			"properties": {
				"class": {
					"type": "string",
					"enum": [
						"sword",
						"dagger",
						"spear",
						"bow",
						"axe",
						"mace",
						"shield",
						"staff",
						"heavy-armour",
						"light-armour",
						"robes"
					]
				},
				"artifactRole": {
					"type": "string",
					"enum": [
						"item",
						"set-source"
					]
				},
				"slot": {
					"anyOf": [
						{
							"type": "string",
							"enum": [
								"head",
								"torso",
								"legs",
								"boots"
							]
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": [
				"class",
				"artifactRole",
				"slot"
			],
			"additionalProperties": false
		},
		"classDirection": {
			"type": "object",
			"properties": {
				"description": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4000
				},
				"anchorReferenceId": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]{1,159}$"
				},
				"pose": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4000
				},
				"proportionRules": {
					"minItems": 1,
					"maxItems": 8,
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 4000
					}
				},
				"consistencyLock": {
					"type": "array",
					"prefixItems": [
						{
							"type": "string",
							"const": "camera"
						},
						{
							"type": "string",
							"const": "pivot"
						},
						{
							"type": "string",
							"const": "normalized-scale"
						},
						{
							"type": "string",
							"const": "presentation-angle"
						}
					]
				}
			},
			"required": [
				"description",
				"anchorReferenceId",
				"pose",
				"proportionRules",
				"consistencyLock"
			],
			"additionalProperties": false
		},
		"consistencySource": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"targetId": {
							"type": "string",
							"pattern": "^[a-z][a-z0-9-]{1,159}$"
						},
						"candidatePath": {
							"type": "string",
							"minLength": 1,
							"maxLength": 500
						},
						"candidateSha256": {
							"type": "string",
							"pattern": "^[a-f0-9]{64}$"
						},
						"reviewReceiptPath": {
							"type": "string",
							"minLength": 1,
							"maxLength": 500
						},
						"reviewReceiptCanonicalSha256": {
							"type": "string",
							"pattern": "^[a-f0-9]{64}$"
						}
					},
					"required": [
						"targetId",
						"candidatePath",
						"candidateSha256",
						"reviewReceiptPath",
						"reviewReceiptCanonicalSha256"
					],
					"additionalProperties": false
				},
				{
					"type": "null"
				}
			]
		},
		"references": {
			"minItems": 2,
			"maxItems": 4,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"referenceId": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{1,159}$"
					},
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 500
					},
					"contentHash": {
						"type": "string",
						"pattern": "^[a-f0-9]{64}$"
					},
					"usage": {
						"type": "string",
						"enum": [
							"style-only",
							"pose-only",
							"camera-and-display-only",
							"continuity-source"
						]
					},
					"purpose": {
						"type": "string",
						"minLength": 1,
						"maxLength": 4000
					}
				},
				"required": [
					"referenceId",
					"path",
					"contentHash",
					"usage",
					"purpose"
				],
				"additionalProperties": false
			}
		},
		"presentation": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"mode": {
							"type": "string",
							"const": "isolated-item"
						},
						"subject": {
							"type": "string",
							"const": "one-complete-object-or-required-pair"
						},
						"composition": {
							"type": "string",
							"minLength": 1,
							"maxLength": 4000
						},
						"canvas": {
							"type": "object",
							"properties": {
								"width": {
									"type": "number",
									"const": 1024
								},
								"height": {
									"type": "number",
									"const": 1024
								},
								"mediaType": {
									"type": "string",
									"const": "image/png"
								}
							},
							"required": [
								"width",
								"height",
								"mediaType"
							],
							"additionalProperties": false
						},
						"framing": {
							"type": "object",
							"properties": {
								"compositionTargetPercent": {
									"type": "number",
									"const": 8
								},
								"hardMinimumPercent": {
									"type": "number",
									"const": 5
								},
								"priority": {
									"type": "string",
									"const": "pose-consistency-over-margin-above-hard-minimum"
								}
							},
							"required": [
								"compositionTargetPercent",
								"hardMinimumPercent",
								"priority"
							],
							"additionalProperties": false
						},
						"negativeConstraints": {
							"minItems": 1,
							"maxItems": 50,
							"type": "array",
							"items": {
								"type": "string",
								"pattern": "^[a-z][a-z0-9-]{1,159}$"
							}
						}
					},
					"required": [
						"mode",
						"subject",
						"composition",
						"canvas",
						"framing",
						"negativeConstraints"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"mode": {
							"type": "string",
							"const": "complete-armour-set"
						},
						"subject": {
							"type": "string",
							"const": "empty-self-supporting-armour-set"
						},
						"composition": {
							"type": "string",
							"minLength": 1,
							"maxLength": 4000
						},
						"canvas": {
							"type": "object",
							"properties": {
								"width": {
									"type": "number",
									"const": 1024
								},
								"height": {
									"type": "number",
									"const": 1536
								},
								"mediaType": {
									"type": "string",
									"const": "image/png"
								}
							},
							"required": [
								"width",
								"height",
								"mediaType"
							],
							"additionalProperties": false
						},
						"framing": {
							"type": "object",
							"properties": {
								"compositionTargetPercent": {
									"type": "number",
									"const": 8
								},
								"hardMinimumPercent": {
									"type": "number",
									"const": 5
								},
								"priority": {
									"type": "string",
									"const": "pose-consistency-over-margin-above-hard-minimum"
								}
							},
							"required": [
								"compositionTargetPercent",
								"hardMinimumPercent",
								"priority"
							],
							"additionalProperties": false
						},
						"interior": {
							"type": "string",
							"const": "natural-interior-cavity-shadow-only"
						},
						"requiredComponents": {
							"type": "array",
							"prefixItems": [
								{
									"type": "string",
									"const": "Head"
								},
								{
									"type": "string",
									"const": "Torso"
								},
								{
									"type": "string",
									"const": "Legs"
								},
								{
									"type": "string",
									"const": "Boots"
								}
							]
						},
						"negativeConstraints": {
							"minItems": 1,
							"maxItems": 50,
							"type": "array",
							"items": {
								"type": "string",
								"pattern": "^[a-z][a-z0-9-]{1,159}$"
							}
						}
					},
					"required": [
						"mode",
						"subject",
						"composition",
						"canvas",
						"framing",
						"interior",
						"requiredComponents",
						"negativeConstraints"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"mode": {
							"type": "string",
							"const": "dependent-armour-piece"
						},
						"subject": {
							"type": "string",
							"const": "one-matching-object-or-required-pair"
						},
						"composition": {
							"type": "string",
							"minLength": 1,
							"maxLength": 4000
						},
						"canvas": {
							"type": "object",
							"properties": {
								"width": {
									"type": "number",
									"const": 1024
								},
								"height": {
									"type": "number",
									"const": 1024
								},
								"mediaType": {
									"type": "string",
									"const": "image/png"
								}
							},
							"required": [
								"width",
								"height",
								"mediaType"
							],
							"additionalProperties": false
						},
						"framing": {
							"type": "object",
							"properties": {
								"compositionTargetPercent": {
									"type": "number",
									"const": 8
								},
								"hardMinimumPercent": {
									"type": "number",
									"const": 5
								},
								"priority": {
									"type": "string",
									"const": "pose-consistency-over-margin-above-hard-minimum"
								}
							},
							"required": [
								"compositionTargetPercent",
								"hardMinimumPercent",
								"priority"
							],
							"additionalProperties": false
						},
						"continuityRequirements": {
							"minItems": 1,
							"maxItems": 20,
							"type": "array",
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 4000
							}
						},
						"negativeConstraints": {
							"minItems": 1,
							"maxItems": 50,
							"type": "array",
							"items": {
								"type": "string",
								"pattern": "^[a-z][a-z0-9-]{1,159}$"
							}
						}
					},
					"required": [
						"mode",
						"subject",
						"composition",
						"canvas",
						"framing",
						"continuityRequirements",
						"negativeConstraints"
					],
					"additionalProperties": false
				}
			]
		},
		"acceptanceCriteria": {
			"minItems": 1,
			"maxItems": 40,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"criterionId": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{1,159}$"
					},
					"category": {
						"type": "string",
						"enum": [
							"canvas-and-framing",
							"object-count",
							"equipment-silhouette",
							"class-pose-consistency",
							"structural-plausibility",
							"material-dominance",
							"material-cue-strength",
							"bounded-rank-behaviour",
							"style-cohesion",
							"negative-constraint-safety",
							"empty-armour-display",
							"source-continuity"
						]
					},
					"description": {
						"type": "string",
						"minLength": 1,
						"maxLength": 4000
					},
					"required": {
						"type": "boolean",
						"const": true
					}
				},
				"required": [
					"criterionId",
					"category",
					"description",
					"required"
				],
				"additionalProperties": false
			}
		},
		"output": {
			"type": "object",
			"properties": {
				"candidatePath": {
					"type": "string",
					"minLength": 1,
					"maxLength": 500
				},
				"provenanceResultPath": {
					"type": "string",
					"minLength": 1,
					"maxLength": 500
				}
			},
			"required": [
				"candidatePath",
				"provenanceResultPath"
			],
			"additionalProperties": false
		}
	},
	"required": [
		"schemaVersion",
		"targetId",
		"productionId",
		"profileId",
		"manifestCanonicalSha256",
		"allocationCanonicalSha256",
		"profileCanonicalSha256",
		"profileAcceptanceCanonicalSha256",
		"material",
		"equipment",
		"classDirection",
		"consistencySource",
		"references",
		"presentation",
		"acceptanceCriteria",
		"output"
	],
	"additionalProperties": false,
	"$id": "https://summonlab.local/schemas/equipment/v2/target.schema.json",
	"$comment": "Structural interchange validation only. Equipment v2 acceptance and packet processing must also run the corresponding Zod semantic schema."
}
