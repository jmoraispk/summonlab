{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "string",
			"const": "equipment-visual-profile-acceptance-v2"
		},
		"acceptanceId": {
			"type": "string",
			"const": "equipment-material-visual-profile-v2-acceptance"
		},
		"productionId": {
			"type": "string",
			"const": "material-equipment-v2"
		},
		"profileId": {
			"type": "string",
			"const": "equipment-material-visual-profile-v2"
		},
		"profileSchemaVersion": {
			"type": "string",
			"const": "equipment-visual-profile-v2"
		},
		"profilePath": {
			"type": "string",
			"const": "assets/equipment/experiments/material-equipment-v2/visual-profile/profile.json"
		},
		"profileCanonicalSha256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"decision": {
			"type": "string",
			"const": "accepted"
		},
		"reviewer": {
			"type": "string",
			"const": "owner"
		},
		"acceptedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"authorizationScope": {
			"type": "string",
			"const": "visual-profile-only"
		}
	},
	"required": [
		"schemaVersion",
		"acceptanceId",
		"productionId",
		"profileId",
		"profileSchemaVersion",
		"profilePath",
		"profileCanonicalSha256",
		"decision",
		"reviewer",
		"acceptedAt",
		"authorizationScope"
	],
	"additionalProperties": false,
	"$id": "https://summonlab.local/schemas/equipment/v2/profile-acceptance.schema.json",
	"$comment": "Structural interchange validation only. Equipment v2 acceptance and packet processing must also run the corresponding Zod semantic schema."
}
