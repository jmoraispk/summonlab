{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "string",
			"const": "equipment-image-assignment-v2"
		},
		"assignmentId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{1,159}$"
		},
		"targetId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{1,159}$"
		},
		"contractVersion": {
			"type": "string",
			"const": "equipment-image-production-contract-v2"
		},
		"rendererVersion": {
			"type": "string",
			"const": "equipment-image-prompt-v2"
		},
		"assignedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"runActivationRequired": {
			"type": "boolean",
			"const": true
		},
		"dryRun": {
			"type": "boolean",
			"const": false
		},
		"retryCeiling": {
			"type": "number",
			"const": 0
		},
		"permittedOutputs": {
			"type": "object",
			"properties": {
				"candidatePath": {
					"type": "string",
					"minLength": 1,
					"maxLength": 500
				},
				"provenanceResultPath": {
					"type": "string",
					"minLength": 1,
					"maxLength": 500
				}
			},
			"required": [
				"candidatePath",
				"provenanceResultPath"
			],
			"additionalProperties": false
		},
		"forbiddenSharedPaths": {
			"minItems": 1,
			"maxItems": 100,
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 500
			}
		},
		"completionContract": {
			"type": "object",
			"properties": {
				"oneTargetOneImage": {
					"type": "boolean",
					"const": true
				},
				"structuredResultRequired": {
					"type": "boolean",
					"const": true
				},
				"sharedFilesMustRemainUntouched": {
					"type": "boolean",
					"const": true
				},
				"selfPromotionForbidden": {
					"type": "boolean",
					"const": true
				}
			},
			"required": [
				"oneTargetOneImage",
				"structuredResultRequired",
				"sharedFilesMustRemainUntouched",
				"selfPromotionForbidden"
			],
			"additionalProperties": false
		}
	},
	"required": [
		"schemaVersion",
		"assignmentId",
		"targetId",
		"contractVersion",
		"rendererVersion",
		"assignedAt",
		"runActivationRequired",
		"dryRun",
		"retryCeiling",
		"permittedOutputs",
		"forbiddenSharedPaths",
		"completionContract"
	],
	"additionalProperties": false,
	"$id": "https://summonlab.local/schemas/equipment/v2/assignment.schema.json",
	"$comment": "Structural interchange validation only. Equipment v2 acceptance and packet processing must also run the corresponding Zod semantic schema."
}
