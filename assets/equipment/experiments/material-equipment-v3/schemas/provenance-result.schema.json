{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "string",
			"const": "equipment-rank-first-provenance-result-v3"
		},
		"resultId": {
			"type": "string",
			"pattern": "^result-material-equipment-v3-[a-z0-9-]+-v3-attempt-[1-9][0-9]*$"
		},
		"targetId": {
			"type": "string",
			"pattern": "^material-equipment-v3-[a-z0-9-]+-v3$"
		},
		"assignmentId": {
			"type": "string",
			"pattern": "^(?:assignment-material-equipment-v3-[a-z0-9-]+-v3|revision-assignment-material-equipment-v3-[a-z0-9-]+-v3-attempt-[2-9][0-9]*)$"
		},
		"attempt": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"status": {
			"type": "string",
			"enum": [
				"succeeded",
				"failed"
			]
		},
		"startedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"completedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"provider": {
			"type": "string",
			"minLength": 1
		},
		"model": {
			"type": "string",
			"minLength": 1
		},
		"promptSha256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"references": {
			"minItems": 2,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"path": {
						"type": "string",
						"pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9._/-]+$"
					},
					"sha256": {
						"type": "string",
						"pattern": "^[a-f0-9]{64}$"
					},
					"purpose": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"path",
					"sha256",
					"purpose"
				],
				"additionalProperties": false
			}
		},
		"source": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"path": {
							"type": "string",
							"minLength": 1
						},
						"sha256": {
							"type": "string",
							"pattern": "^[a-f0-9]{64}$"
						},
						"bytes": {
							"type": "integer",
							"exclusiveMinimum": 0,
							"maximum": 9007199254740991
						},
						"width": {
							"type": "integer",
							"exclusiveMinimum": 0,
							"maximum": 9007199254740991
						},
						"height": {
							"type": "integer",
							"exclusiveMinimum": 0,
							"maximum": 9007199254740991
						},
						"mediaType": {
							"type": "string",
							"enum": [
								"image/png",
								"image/webp",
								"image/jpeg"
							]
						}
					},
					"required": [
						"path",
						"sha256",
						"bytes",
						"width",
						"height",
						"mediaType"
					],
					"additionalProperties": false
				},
				{
					"type": "null"
				}
			]
		},
		"persistenceOperation": {
			"anyOf": [
				{
					"type": "string",
					"enum": [
						"exclusive-copy",
						"exclusive-normalize"
					]
				},
				{
					"type": "null"
				}
			]
		},
		"output": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"path": {
							"type": "string",
							"pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9._/-]+$"
						},
						"sha256": {
							"type": "string",
							"pattern": "^[a-f0-9]{64}$"
						},
						"bytes": {
							"type": "integer",
							"exclusiveMinimum": 0,
							"maximum": 9007199254740991
						},
						"width": {
							"type": "integer",
							"exclusiveMinimum": 0,
							"maximum": 9007199254740991
						},
						"height": {
							"type": "integer",
							"exclusiveMinimum": 0,
							"maximum": 9007199254740991
						},
						"mediaType": {
							"type": "string",
							"const": "image/png"
						}
					},
					"required": [
						"path",
						"sha256",
						"bytes",
						"width",
						"height",
						"mediaType"
					],
					"additionalProperties": false
				},
				{
					"type": "null"
				}
			]
		},
		"error": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"minLength": 1
						},
						"message": {
							"type": "string",
							"minLength": 1
						}
					},
					"required": [
						"kind",
						"message"
					],
					"additionalProperties": false
				},
				{
					"type": "null"
				}
			]
		}
	},
	"required": [
		"schemaVersion",
		"resultId",
		"targetId",
		"assignmentId",
		"attempt",
		"status",
		"startedAt",
		"completedAt",
		"provider",
		"model",
		"promptSha256",
		"references",
		"source",
		"persistenceOperation",
		"output",
		"error"
	],
	"additionalProperties": false,
	"$id": "https://summonlab.local/schemas/equipment/v3/provenance-result.schema.json",
	"$comment": "Structural interchange validation only; semantic validation uses the corresponding Zod schema."
}
