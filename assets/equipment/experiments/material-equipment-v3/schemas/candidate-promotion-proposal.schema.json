{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "string",
			"const": "equipment-candidate-promotion-proposal-v3"
		},
		"proposalId": {
			"type": "string",
			"const": "material-equipment-v3-candidate-promotion-v1"
		},
		"createdAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"createdBy": {
			"type": "string",
			"minLength": 1
		},
		"status": {
			"type": "string",
			"const": "proposal-only"
		},
		"checkpoint3": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9._/-]+$"
				},
				"canonicalSha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			},
			"required": [
				"path",
				"canonicalSha256"
			],
			"additionalProperties": false
		},
		"entries": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"targetId": {
						"type": "string",
						"pattern": "^material-equipment-v3-[a-z0-9-]+-v3$"
					},
					"candidatePath": {
						"type": "string",
						"pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9._/-]+$"
					},
					"candidateSha256": {
						"type": "string",
						"pattern": "^[a-f0-9]{64}$"
					},
					"ownerDecision": {
						"type": "string",
						"const": "accept"
					}
				},
				"required": [
					"targetId",
					"candidatePath",
					"candidateSha256",
					"ownerDecision"
				],
				"additionalProperties": false
			}
		},
		"excluded": {
			"type": "object",
			"properties": {
				"accept": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"revise": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"defer": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"accept",
				"revise",
				"defer"
			],
			"additionalProperties": false
		},
		"forbiddenActions": {
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"noRuntimeMutation": {
			"type": "boolean",
			"const": true
		}
	},
	"required": [
		"schemaVersion",
		"proposalId",
		"createdAt",
		"createdBy",
		"status",
		"checkpoint3",
		"entries",
		"excluded",
		"forbiddenActions",
		"noRuntimeMutation"
	],
	"additionalProperties": false,
	"$id": "https://summonlab.local/schemas/equipment/v3/candidate-promotion-proposal.schema.json",
	"$comment": "Structural interchange validation only; semantic validation uses the corresponding Zod schema."
}
