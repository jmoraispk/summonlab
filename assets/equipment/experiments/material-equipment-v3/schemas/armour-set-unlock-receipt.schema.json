{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "string",
			"const": "equipment-armour-set-unlock-receipt-v3"
		},
		"setId": {
			"type": "string",
			"minLength": 1
		},
		"sourceTargetId": {
			"type": "string",
			"pattern": "^material-equipment-v3-[a-z0-9-]+-full-set-v3$"
		},
		"sourceCandidatePath": {
			"type": "string",
			"pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9._/-]+$"
		},
		"sourceCandidateSha256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"classAuditDecision": {
			"type": "string",
			"const": "accept"
		},
		"materialAuditDecision": {
			"type": "string",
			"const": "accept"
		},
		"emptySetCheck": {
			"type": "string",
			"const": "pass"
		},
		"fourComponentCheck": {
			"type": "string",
			"const": "pass"
		},
		"acceptedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"acceptedBy": {
			"type": "string",
			"minLength": 1
		},
		"unlocksTargetIds": {
			"minItems": 4,
			"maxItems": 4,
			"type": "array",
			"items": {
				"type": "string"
			}
		}
	},
	"required": [
		"schemaVersion",
		"setId",
		"sourceTargetId",
		"sourceCandidatePath",
		"sourceCandidateSha256",
		"classAuditDecision",
		"materialAuditDecision",
		"emptySetCheck",
		"fourComponentCheck",
		"acceptedAt",
		"acceptedBy",
		"unlocksTargetIds"
	],
	"additionalProperties": false,
	"$id": "https://summonlab.local/schemas/equipment/v3/armour-set-unlock-receipt.schema.json",
	"$comment": "Structural interchange validation only; semantic validation uses the corresponding Zod schema."
}
