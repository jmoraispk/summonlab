{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "string",
			"const": "equipment-rank-first-assignment-v3"
		},
		"assignmentId": {
			"type": "string",
			"pattern": "^assignment-material-equipment-v3-[a-z0-9-]+-v3$"
		},
		"targetId": {
			"type": "string",
			"pattern": "^material-equipment-v3-[a-z0-9-]+-v3$"
		},
		"immutable": {
			"type": "boolean",
			"const": true
		},
		"classDirection": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9._/-]+$"
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				},
				"purpose": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": [
				"path",
				"sha256",
				"purpose"
			],
			"additionalProperties": false
		},
		"materialBrief": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9._/-]+$"
				},
				"canonicalSha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				}
			},
			"required": [
				"path",
				"canonicalSha256"
			],
			"additionalProperties": false
		},
		"finishReference": {
			"type": "object",
			"properties": {
				"path": {
					"type": "string",
					"pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9._/-]+$"
				},
				"sha256": {
					"type": "string",
					"pattern": "^[a-f0-9]{64}$"
				},
				"purpose": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": [
				"path",
				"sha256",
				"purpose"
			],
			"additionalProperties": false
		},
		"consistencySource": {
			"anyOf": [
				{
					"type": "object",
					"properties": {
						"path": {
							"type": "string",
							"pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9._/-]+$"
						},
						"sha256": {
							"type": "string",
							"pattern": "^[a-f0-9]{64}$"
						},
						"purpose": {
							"type": "string",
							"minLength": 1
						}
					},
					"required": [
						"path",
						"sha256",
						"purpose"
					],
					"additionalProperties": false
				},
				{
					"type": "null"
				}
			]
		},
		"prompt": {
			"type": "string",
			"minLength": 1
		},
		"promptSha256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"permittedOutputs": {
			"type": "object",
			"properties": {
				"candidatePath": {
					"type": "string",
					"pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9._/-]+$"
				},
				"resultPath": {
					"type": "string",
					"pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[a-zA-Z0-9._/-]+$"
				}
			},
			"required": [
				"candidatePath",
				"resultPath"
			],
			"additionalProperties": false
		},
		"forbiddenActions": {
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		}
	},
	"required": [
		"schemaVersion",
		"assignmentId",
		"targetId",
		"immutable",
		"classDirection",
		"materialBrief",
		"finishReference",
		"consistencySource",
		"prompt",
		"promptSha256",
		"permittedOutputs",
		"forbiddenActions"
	],
	"additionalProperties": false,
	"$id": "https://summonlab.local/schemas/equipment/v3/assignment.schema.json",
	"$comment": "Structural interchange validation only; semantic validation uses the corresponding Zod schema."
}
