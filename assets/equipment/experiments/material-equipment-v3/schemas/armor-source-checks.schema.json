{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "string",
			"const": "equipment-armor-source-checks-v3"
		},
		"checksId": {
			"type": "string",
			"pattern": "^equipment-v3-armor-source-checks-v[1-9][0-9]*$"
		},
		"createdAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"createdBy": {
			"type": "string",
			"minLength": 1
		},
		"checks": {
			"minItems": 21,
			"maxItems": 21,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"sourceTargetId": {
						"type": "string",
						"pattern": "^material-equipment-v3-[a-z0-9-]+-full-set-v3$"
					},
					"emptySetCheck": {
						"type": "string",
						"const": "pass"
					},
					"fourComponentCheck": {
						"type": "string",
						"const": "pass"
					},
					"notes": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"sourceTargetId",
					"emptySetCheck",
					"fourComponentCheck",
					"notes"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"schemaVersion",
		"checksId",
		"createdAt",
		"createdBy",
		"checks"
	],
	"additionalProperties": false,
	"$id": "https://summonlab.local/schemas/equipment/v3/armor-source-checks.schema.json",
	"$comment": "Structural interchange validation only; semantic validation uses the corresponding Zod schema."
}
