{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "string",
			"const": "equipment-armour-piece-withheld-call-audit-v1"
		},
		"auditId": {
			"type": "string",
			"const": "equipment-v3-armour-piece-withheld-calls-v1"
		},
		"auditedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"provider": {
			"type": "string",
			"minLength": 1
		},
		"model": {
			"type": "string",
			"minLength": 1
		},
		"callCount": {
			"type": "integer",
			"exclusiveMinimum": 0,
			"maximum": 9007199254740991
		},
		"policy": {
			"type": "string",
			"minLength": 1
		},
		"calls": {
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"targetId": {
						"type": "string",
						"pattern": "^material-equipment-v3-[a-z0-9-]+-v3$"
					},
					"attempt": {
						"type": "integer",
						"minimum": 1,
						"maximum": 9007199254740991
					},
					"sourcePath": {
						"type": "string",
						"pattern": "^\\/.*"
					},
					"sourceSha256": {
						"type": "string",
						"pattern": "^[a-f0-9]{64}$"
					},
					"rejection": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"targetId",
					"attempt",
					"sourcePath",
					"sourceSha256",
					"rejection"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"schemaVersion",
		"auditId",
		"auditedAt",
		"provider",
		"model",
		"callCount",
		"policy",
		"calls"
	],
	"additionalProperties": false,
	"$id": "https://summonlab.local/schemas/equipment/v3/withheld-call-audit.schema.json",
	"$comment": "Structural interchange validation only; semantic validation uses the corresponding Zod schema."
}
