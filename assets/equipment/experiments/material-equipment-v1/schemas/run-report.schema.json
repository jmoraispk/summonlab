{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "string",
			"const": "equipment-production-run-report-v1"
		},
		"reportId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{1,119}$"
		},
		"runId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{1,119}$"
		},
		"generatedAt": {
			"type": "string",
			"format": "date-time",
			"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
		},
		"status": {
			"type": "string",
			"enum": [
				"not-started",
				"running",
				"paused",
				"completed",
				"blocked"
			]
		},
		"summary": {
			"type": "object",
			"properties": {
				"totalJobs": {
					"type": "number",
					"const": 161
				},
				"readyJobs": {
					"type": "integer",
					"minimum": 0,
					"maximum": 161
				},
				"claimedJobs": {
					"type": "integer",
					"minimum": 0,
					"maximum": 161
				},
				"activeJobs": {
					"type": "integer",
					"minimum": 0,
					"maximum": 16
				},
				"terminalJobs": {
					"type": "integer",
					"minimum": 0,
					"maximum": 161
				},
				"acceptedArmourGates": {
					"type": "integer",
					"minimum": 0,
					"maximum": 21
				},
				"technicalFailuresInEpoch": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"peakActiveEquipmentWorkers": {
					"type": "integer",
					"minimum": 0,
					"maximum": 16
				},
				"maximumConcurrency": {
					"type": "number",
					"const": 16
				}
			},
			"required": [
				"totalJobs",
				"readyJobs",
				"claimedJobs",
				"activeJobs",
				"terminalJobs",
				"acceptedArmourGates",
				"technicalFailuresInEpoch",
				"peakActiveEquipmentWorkers",
				"maximumConcurrency"
			],
			"additionalProperties": false
		},
		"readyTargetIds": {
			"maxItems": 161,
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9-]{1,119}$"
			}
		},
		"claimedTargetIds": {
			"maxItems": 161,
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9-]{1,119}$"
			}
		},
		"activeTargetIds": {
			"maxItems": 16,
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9-]{1,119}$"
			}
		},
		"terminalTargetIds": {
			"maxItems": 161,
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9-]{1,119}$"
			}
		},
		"blockers": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"code": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{1,119}$"
					},
					"message": {
						"type": "string",
						"minLength": 1,
						"maxLength": 2000
					},
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 500
					}
				},
				"required": [
					"code",
					"message"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"schemaVersion",
		"reportId",
		"runId",
		"generatedAt",
		"status",
		"summary",
		"readyTargetIds",
		"claimedTargetIds",
		"activeTargetIds",
		"terminalTargetIds",
		"blockers"
	],
	"additionalProperties": false,
	"$id": "https://summonlab.local/schemas/equipment/run-report.schema.json"
}
