{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"schemaVersion": {
			"type": "string",
			"const": "equipment-visual-profile-v1"
		},
		"profileId": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]{1,119}$"
		},
		"status": {
			"type": "string",
			"const": "approval-candidate"
		},
		"craftsmanship": {
			"type": "object",
			"properties": {
				"grade": {
					"type": "string",
					"const": "Standard"
				},
				"rankAdjustment": {
					"type": "number",
					"const": 0
				}
			},
			"required": [
				"grade",
				"rankAdjustment"
			],
			"additionalProperties": false
		},
		"style": {
			"type": "object",
			"properties": {
				"medium": {
					"type": "string",
					"minLength": 1,
					"maxLength": 2000
				},
				"construction": {
					"type": "string",
					"minLength": 1,
					"maxLength": 2000
				},
				"materialResponse": {
					"type": "string",
					"minLength": 1,
					"maxLength": 2000
				},
				"lighting": {
					"type": "string",
					"minLength": 1,
					"maxLength": 2000
				},
				"background": {
					"type": "string",
					"minLength": 1,
					"maxLength": 2000
				}
			},
			"required": [
				"medium",
				"construction",
				"materialResponse",
				"lighting",
				"background"
			],
			"additionalProperties": false
		},
		"isolatedPresentation": {
			"type": "object",
			"properties": {
				"mode": {
					"type": "string",
					"const": "isolated-item-or-piece"
				},
				"subject": {
					"type": "string",
					"const": "one-complete-object-or-required-pair"
				},
				"composition": {
					"type": "string",
					"minLength": 1,
					"maxLength": 2000
				},
				"canvas": {
					"type": "object",
					"properties": {
						"width": {
							"type": "number",
							"const": 1024
						},
						"height": {
							"type": "number",
							"const": 1024
						},
						"mediaType": {
							"type": "string",
							"const": "image/png"
						},
						"safeMarginPercent": {
							"type": "number",
							"const": 8
						}
					},
					"required": [
						"width",
						"height",
						"mediaType",
						"safeMarginPercent"
					],
					"additionalProperties": false
				}
			},
			"required": [
				"mode",
				"subject",
				"composition",
				"canvas"
			],
			"additionalProperties": false
		},
		"fullSetPresentation": {
			"type": "object",
			"properties": {
				"mode": {
					"type": "string",
					"const": "complete-armour-set"
				},
				"subject": {
					"type": "string",
					"const": "featureless-charcoal-display-form"
				},
				"composition": {
					"type": "string",
					"minLength": 1,
					"maxLength": 2000
				},
				"canvas": {
					"type": "object",
					"properties": {
						"width": {
							"type": "number",
							"const": 1024
						},
						"height": {
							"type": "number",
							"const": 1536
						},
						"mediaType": {
							"type": "string",
							"const": "image/png"
						},
						"safeMarginPercent": {
							"type": "number",
							"const": 8
						}
					},
					"required": [
						"width",
						"height",
						"mediaType",
						"safeMarginPercent"
					],
					"additionalProperties": false
				}
			},
			"required": [
				"mode",
				"subject",
				"composition",
				"canvas"
			],
			"additionalProperties": false
		},
		"dependentPiecePresentation": {
			"type": "object",
			"properties": {
				"mode": {
					"type": "string",
					"const": "dependent-armour-piece"
				},
				"subject": {
					"type": "string",
					"const": "one-matching-object-or-required-pair"
				},
				"composition": {
					"type": "string",
					"minLength": 1,
					"maxLength": 2000
				},
				"canvas": {
					"type": "object",
					"properties": {
						"width": {
							"type": "number",
							"const": 1024
						},
						"height": {
							"type": "number",
							"const": 1024
						},
						"mediaType": {
							"type": "string",
							"const": "image/png"
						},
						"safeMarginPercent": {
							"type": "number",
							"const": 8
						}
					},
					"required": [
						"width",
						"height",
						"mediaType",
						"safeMarginPercent"
					],
					"additionalProperties": false
				},
				"continuityRequirements": {
					"minItems": 1,
					"maxItems": 20,
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{1,119}$"
					}
				}
			},
			"required": [
				"mode",
				"subject",
				"composition",
				"canvas",
				"continuityRequirements"
			],
			"additionalProperties": false
		},
		"equipmentClassDefaults": {
			"minItems": 1,
			"maxItems": 30,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"equipmentClass": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{1,119}$"
					},
					"description": {
						"type": "string",
						"minLength": 1,
						"maxLength": 2000
					}
				},
				"required": [
					"equipmentClass",
					"description"
				],
				"additionalProperties": false
			}
		},
		"references": {
			"minItems": 1,
			"maxItems": 20,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"path": {
						"type": "string",
						"minLength": 1,
						"maxLength": 500
					},
					"contentHash": {
						"type": "string",
						"pattern": "^[a-f0-9]{64}$"
					},
					"purpose": {
						"type": "string",
						"minLength": 1,
						"maxLength": 2000
					}
				},
				"required": [
					"path",
					"contentHash",
					"purpose"
				],
				"additionalProperties": false
			}
		},
		"negativeConstraints": {
			"minItems": 1,
			"maxItems": 50,
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9-]{1,119}$"
			}
		}
	},
	"required": [
		"schemaVersion",
		"profileId",
		"status",
		"craftsmanship",
		"style",
		"isolatedPresentation",
		"fullSetPresentation",
		"dependentPiecePresentation",
		"equipmentClassDefaults",
		"references",
		"negativeConstraints"
	],
	"additionalProperties": false,
	"$id": "https://summonlab.local/schemas/equipment/profile.schema.json"
}
